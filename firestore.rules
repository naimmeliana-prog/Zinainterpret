rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'alias', 'preferredUiLang', 'preferredTheme',
          'defaultSourceLang', 'defaultTargetLang', 'cloudSyncEnabled',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'alias', 'preferredUiLang', 'preferredTheme',
          'defaultSourceLang', 'defaultTargetLang', 'cloudSyncEnabled',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.alias is string && data.alias.size() >= 2 && data.alias.size() <= 32
        && data.alias.matches('^[a-zA-Z0-9_\\- ]+$')
        && data.preferredUiLang in ['es', 'en', 'fr', 'de', 'it', 'pt']
        && data.preferredTheme in ['system', 'dark', 'light']
        && data.defaultSourceLang is string && data.defaultSourceLang.size() >= 2 && data.defaultSourceLang.size() <= 16
        && data.defaultTargetLang is string && data.defaultTargetLang.size() >= 2 && data.defaultTargetLang.size() <= 16
        && data.cloudSyncEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: EncryptedBackup
    function isValidEncryptedBackup(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'label', 'algorithm', 'ciphertext', 'iv', 'salt',
          'sessionCount', 'byteSize', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'label', 'algorithm', 'ciphertext', 'iv', 'salt',
          'sessionCount', 'byteSize', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 64
        && data.algorithm == 'AES-GCM-256'
        && data.ciphertext is string && data.ciphertext.size() >= 16 && data.ciphertext.size() <= 700000
        && data.iv is string && data.iv.size() >= 8 && data.iv.size() <= 64
        && data.salt is string && data.salt.size() >= 8 && data.salt.size() <= 64
        && data.sessionCount is int && data.sessionCount >= 0 && data.sessionCount <= 50000
        && data.byteSize is int && data.byteSize >= 0 && data.byteSize <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: ProgressSummary
    function isValidProgressSummary(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'exerciseId', 'mode', 'sourceLang', 'targetLang',
          'fluencyScore', 'precisionScore', 'intonationScore', 'wpm',
          'durationSec', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'exerciseId', 'mode', 'sourceLang', 'targetLang',
          'fluencyScore', 'precisionScore', 'intonationScore', 'wpm',
          'durationSec', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.exerciseId is string && isValidId(data.exerciseId) && data.exerciseId.size() <= 64
        && data.mode in ['simultaneous', 'consecutive']
        && data.sourceLang is string && data.sourceLang.size() >= 2 && data.sourceLang.size() <= 16
        && data.targetLang is string && data.targetLang.size() >= 2 && data.targetLang.size() <= 16
        && data.fluencyScore is int && data.fluencyScore >= 0 && data.fluencyScore <= 100
        && data.precisionScore is int && data.precisionScore >= 0 && data.precisionScore <= 100
        && data.intonationScore is int && data.intonationScore >= 0 && data.intonationScore <= 100
        && data.wpm is int && data.wpm >= 0 && data.wpm <= 400
        && data.durationSec is int && data.durationSec >= 0 && data.durationSec <= 7200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Users Collection: Zero directory listing; strict single-owner access
    match /users/{userId} {
      allow list: if false;
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'alias', 'preferredUiLang', 'preferredTheme',
          'defaultSourceLang', 'defaultTargetLang', 'cloudSyncEnabled', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);

      // Encrypted Cloud Backups Subcollection
      match /backups/{backupId} {
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow get: if isValidId(userId)
          && isValidId(backupId)
          && isOwner(userId)
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(backupId)
          && isOwner(userId)
          && isValidEncryptedBackup(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow update: if isValidId(userId)
          && isValidId(backupId)
          && isOwner(userId)
          && isValidEncryptedBackup(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'label', 'ciphertext', 'iv', 'salt', 'sessionCount', 'byteSize', 'updatedAt'
          ])
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow delete: if isValidId(userId)
          && isValidId(backupId)
          && isOwner(userId)
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
      }

      // Real-time Multi-Platform Progress Summaries Subcollection
      match /progressSummaries/{summaryId} {
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow get: if isValidId(userId)
          && isValidId(summaryId)
          && isOwner(userId)
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(summaryId)
          && isOwner(userId)
          && isValidProgressSummary(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow update: if isValidId(userId)
          && isValidId(summaryId)
          && isOwner(userId)
          && isValidProgressSummary(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'fluencyScore', 'precisionScore', 'intonationScore', 'wpm', 'durationSec', 'updatedAt'
          ])
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow delete: if isValidId(userId)
          && isValidId(summaryId)
          && isOwner(userId)
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
